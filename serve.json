{
  "rewrites": [
    { "source": "/es", "destination": "/es/index.html" },
    { "source": "/en", "destination": "/en/index.html" }
  ],
  "headers": [
    {
      "source": "**/*.@(js|css)",
      "headers": [
        { "key": "Cache-Control", "value": "no-cache" }
      ]
    }
  ],
  "cleanUrls": false,
  "trailingSlash": true
}
